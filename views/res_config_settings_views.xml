<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_student_registration_config_form" model="ir.ui.view">
        <field name="name">student.registration.config.form</field>
        <field name="model">res.config.settings</field>
        <field name="arch" type="xml">
            <form string="Student Registration Settings">
                <sheet>
                    <div class="oe_title">
                        <h1>Student Registration Number</h1>
                        <p class="text-muted">
                            Format: PREFIX / Financial Year / Serial (e.g. ANJ/2026/01).
                            Financial year runs April to March. Serial continues when the year changes.
                        </p>
                    </div>
                    <group>
                        <group>
                            <field name="student_registration_prefix"
                                   placeholder="ANJ"/>
                        </group>
                        <group>
                            <field name="student_registration_next_number"/>
                        </group>
                    </group>
                    <div class="oe_title" style="margin-top:24px;">
                        <h1>Moodle &amp; Portal Access</h1>
                        <p class="text-muted">
                            Used by the "Create Portal Users / Sync to Moodle" action on students.
                        </p>
                    </div>
                    <group>
                        <group>
                            <field name="moodle_base_url" placeholder="https://moodle.example.org"/>
                            <field name="moodle_ws_token" password="True"/>
                            <button name="action_test_moodle_connection" type="object"
                                    string="🔌 Test Moodle Connection" class="btn-secondary"/>
                        </group>
                        <group>
                            <field name="portal_default_password" password="True"/>
                            <field name="moodle_fallback_email_domain"/>
                            <field name="moodle_student_role_id"/>
                        </group>
                    </group>
                    <div class="oe_title" style="margin-top:24px;">
                        <h1>Razorpay Payment Links</h1>
                        <p class="text-muted">
                            Used by "Generate Payment Link" on enrollments/payments.
                            Webhook URL to configure in the Razorpay Dashboard:
                            &lt;your-odoo-url&gt;/razorpay/webhook — subscribe it to
                            payment_link.paid and payment_link.partially_paid.
                        </p>
                    </div>
                    <group>
                        <group>
                            <field name="razorpay_key_id"/>
                            <field name="razorpay_key_secret" password="True"/>
                        </group>
                        <group>
                            <field name="razorpay_webhook_secret" password="True"/>
                        </group>
                    </group>
                    <div class="oe_title" style="margin-top:24px;">
                        <h1>Attendance WhatsApp Alerts</h1>
                        <p class="text-muted">
                            Guardians receive a WhatsApp message when their child is marked absent
                            (optionally late) and when attendance falls below the minimum. Messages use your approved Meta templates (or the text below with a gateway) and are
                            queued and sent within minutes; see Attendance &gt; WhatsApp Log.
                            Placeholders: {student} {reg_no} {batch} {date} {session} {institute}
                            {percentage} {threshold} {date_from} {date_to}. Marks: {exam} {subject} {marks} {result} {rank} {average}.
                        </p>
                    </div>
                    <group>
                        <group>
                            <field name="att_wa_enabled"/>
                            <field name="att_wa_provider"/>
                            <field name="att_wa_notify_scope"/>
                            <field name="att_wa_low_threshold"/>
                            <field name="att_wa_country_code"/>
                            <field name="att_wa_institute_name"/>
                        </group>
                        <group>
                            <field name="att_wa_meta_phone_id" invisible="att_wa_provider != 'meta'"/>
                            <field name="att_wa_meta_token" password="True" invisible="att_wa_provider != 'meta'"/>
                            <field name="att_wa_meta_waba_id" invisible="att_wa_provider != 'meta'"/>
                            <field name="att_wa_meta_api_version" invisible="att_wa_provider != 'meta'"/>
                            <field name="att_wa_template_lang" invisible="att_wa_provider != 'meta'"/>
                            <field name="att_wa_gateway_url" invisible="att_wa_provider != 'gateway'"/>
                            <field name="att_wa_gateway_token" password="True" invisible="att_wa_provider != 'gateway'"/>
                            <button name="action_att_wa_check_connection" type="object" invisible="att_wa_provider != 'meta'"
                                    string="Check connection" class="btn-link"/>
                        </group>
                    </group>
                    <group invisible="att_wa_provider != 'meta'">
                        <group>
                            <field name="att_wa_absent_template"/>
                            <field name="att_wa_late_template"/>
                        </group>
                        <group>
                            <field name="att_wa_low_template"/>
                            <field name="att_wa_marks_template"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="att_wa_test_number" placeholder="e.g. 9876543210"/>
                            <button name="action_att_wa_test" type="object"
                                    string="Send Test Message" class="btn-secondary"/>
                        </group>
                    </group>
                    <group>
                        <field name="att_wa_absent_message" widget="text"/>
                        <field name="att_wa_late_message" widget="text"/>
                        <field name="att_wa_low_message" widget="text"/>
                        <field name="att_wa_marks_message" widget="text"/>
                        <field name="att_wa_marks_auto"/>
                    </group>
                <div class="oe_title" style="margin-top:24px;">
                        <h1>Demo Data</h1>
                        <p class="text-muted">
                            For demonstrations / training only. Creates demo users for every role
                            (password Demo@1234), courses, batches, fee structures, 30 students with
                            payments, transfers and attendance. Never load on a live database.
                        </p>
                    </div>
                    <group>
                        <button name="action_load_demo_data" type="object" string="Load Demo Data"
                                class="btn-primary"
                                confirm="Create demo users, batches and students? Use only on a demo/training database."/>
                        <button name="action_remove_demo_data" type="object" string="Remove Demo Data"
                                class="btn-secondary"
                                confirm="Delete all demo records created by Load Demo Data?"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Save" name="execute" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_student_registration_settings" model="ir.actions.act_window">
        <field name="name">Registration Number Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_student_registration_config_form"/>
    </record>

    <menuitem id="menu_student_registration_settings"
              name="Registration Settings"
              parent="menu_student_root"
              action="action_student_registration_settings"
              sequence="90"
              groups="student_details_19.group_student_manager"/>
</odoo>
