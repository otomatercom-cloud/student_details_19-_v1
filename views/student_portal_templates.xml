    <template id="portal_student_review" name="Review Student">
        <t t-call="website.layout">
            <div class="container py-5">
                <div class="row justify-content-center">
                    <div class="col-lg-10">
                        <div class="card shadow-lg border-0 rounded-lg overflow-hidden">
                            <div class="card-header bg-success text-white text-center py-4">
                                <h2 class="fw-bold mb-0">Review Your Details</h2>
                                <p class="mb-0 opacity-75">Please confirm that all information is correct</p>
                            </div>
                            <div class="card-body p-5 bg-light">
                                <form method="post" action="/my/students/details/submit">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                                    <!-- Pass all hidden fields -->
                                    <t t-foreach="student.items()" t-as="item">
                                        <t t-if="item[0] == 'course_ids[]'">
                                            <t t-foreach="item[1]" t-as="cid">
                                                <input type="hidden" name="course_ids" t-att-value="cid"/>
                                            </t>
                                        </t>
                                        <t t-elif="item[0] != 'photo_preview'">
                                            <input type="hidden" t-att-name="item[0]" t-att-value="item[1]"/>
                                        </t>
                                    </t>

                                    <div class="row align-items-center mb-5 bg-white p-4 rounded shadow-sm">
                                        <div class="col-md-3 text-center">
                                            <div class="d-inline-block p-1 border rounded bg-white shadow-sm">
                                                <img t-if="student.get('photo_preview')"
                                                     t-att-src="'data:image/png;base64,%s' % student.get('photo_preview')"
                                                     class="img-fluid rounded"
                                                     style="width: 150px; height: 190px; object-fit: cover;"
                                                     alt="Student Photo"/>
                                            </div>
                                        </div>
                                        <div class="col-md-9 border-start ps-4">
                                            <h3 class="text-success mb-1">
                                                <t t-esc="student.get('name')"/>
                                            </h3>
                                            <p class="text-muted mb-2">
                                                <i class="fa fa-envelope me-2"/>
                                                <t t-esc="student.get('email')"/>
                                            </p>
                                            <p class="text-muted mb-2">
                                                <i class="fa fa-phone me-2"/>
                                                <t t-esc="student.get('phone')"/>
                                            </p>
                                            <div class="d-flex flex-wrap gap-2 mt-3">
                                                <span class="badge bg-light text-dark border p-2">
                                                    <i class="fa fa-birthday-cake me-1 text-success"/>
                                                    <t t-esc="student.get('date_of_birth')"/>
                                                </span>
                                                <span class="badge bg-light text-dark border p-2">
                                                    <i class="fa fa-birthday-cake me-1 text-success"/>
                                                    <t t-esc="student.get('date_of_birth')"/>
                                                </span>
                                                <span class="badge bg-light text-dark border p-2">
                                                    <i class="fa fa-venus-mars me-1 text-success"/>
                                                    <t t-esc="student.get('gender')"/>
                                                </span>
                                                <span class="badge bg-light text-dark border p-2">
                                                    <i class="fa fa-info-circle me-1 text-success"/>
                                                    <t t-esc="student.get('joining_status')"/>
                                                </span>
                                                <span class="badge bg-light text-dark border p-2">
                                                    <i class="fa fa-map-marker me-1 text-success"/>
                                                    <t t-esc="student.get('branch')"/>
                                                </span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="bg-white p-4 rounded shadow-sm mb-4">
                                        <h5 class="text-success border-bottom pb-2 mb-4">Details Summary</h5>
                                        <div class="row g-3">
                                            <div class="col-md-6 border-bottom pb-2">
                                                <strong>Address:</strong>
                                                <span class="d-block text-muted"><t t-esc="student.get('district')"/>,
                                                    <t t-esc="student.get('city')"/>
                                                </span>
                                            </div>
                                            <div class="col-md-6 border-bottom pb-2">
                                                <strong>Academic:</strong>
                                                <span class="d-block text-muted">
                                                    <t t-esc="student.get('qualification')"/>
                                                    from
                                                    <t t-esc="student.get('school')"/>
                                                    /
                                                    <t t-esc="student.get('college')"/>
                                                </span>
                                            </div>
                                            <div class="col-md-12 border-bottom pb-2">
                                                <strong>Selected Course:</strong>
                                                <span class="d-block text-success fw-bold">
                                                    <t t-esc="student.get('course_name')"/>
                                                </span>
                                            </div>
                                            <div class="col-md-12 border-bottom pb-2"
                                                 t-if="student.get('admission_officer_text')">
                                                <strong>Admission Officer:</strong>
                                                <span class="d-block text-muted">
                                                    <t t-esc="student.get('admission_officer_text')"/>
                                                </span>
                                            </div>

                                            <div class="col-md-6 border-bottom pb-2 pt-2">
                                                <strong>Guardian:</strong>
                                                <span class="d-block text-muted">
                                                    <t t-esc="student.get('father_name')"/> &amp;
                                                    <t t-esc="student.get('mother_name')"/>
                                                </span>
                                            </div>
                                            <div class="col-md-6 border-bottom pb-2 pt-2">
                                                <strong>Guardian Phones:</strong>
                                                <span class="d-block text-muted">
                                                    <t t-esc="student.get('father_phone')"/>
                                                    /
                                                    <t t-esc="student.get('mother_phone')"/>
                                                </span>
                                            </div>
                                            <div class="col-md-6 border-bottom pb-2 pt-2">
                                                <strong>Whatsapp:</strong>
                                                <span class="d-block text-muted">
                                                    <t t-esc="student.get('whatsapp_number')"/>
                                                </span>
                                            </div>
                                            <div class="col-md-6 border-bottom pb-2 pt-2">
                                                <strong>Instagram:</strong>
                                                <span class="d-block text-muted">
                                                    <t t-esc="student.get('insta_id')"/>
                                                </span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="d-flex justify-content-between mt-5">
                                        <button type="button" class="btn btn-outline-secondary px-4 py-2"
                                                onclick="window.history.back();">
                                            <i class="fa fa-arrow-left me-2"/>
                                            Edit Details
                                        </button>
                                        <button type="submit"
                                                class="btn btn-success btn-lg px-5 py-3 shadow-sm fw-bold">
                                            Confirm and Submit
                                            <i class="fa fa-check-circle ms-2"/>
                                        </button>
                                    </div>

                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>


    <!-- ======================== SUCCESS PAGE ======================== -->
    <template id="portal_student_success" name="Student Submission Success">
        <t t-call="website.layout">
            <div class="container py-5 text-center"
                 style="min-height: 50vh; display: flex; align-items: center; justify-content: center;">
                <div class="alert alert-success border-0 shadow-lg p-5 rounded-lg" style="max-width: 600px;">
                    <div class="mb-4">
                        <i class="fa fa-check-circle text-success" style="font-size: 5rem;"/>
                    </div>
                    <h3 class="fw-bold mb-3 success-text">Submitted Successfully!</h3>
                    <p class="text-muted mb-4">Thank you for registering. Your details have been recorded.</p>
                    <div class="spinner-border text-success" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="text-muted small mt-3">Redirecting you to home page...</p>
                </div>
                <script>
                    setTimeout(function() {
                    window.location.href = "https://logiceducation.org/";
                    }, 3000);
                </script>
            </div>
        </t>
    </template>

</odoo>
