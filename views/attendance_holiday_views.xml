<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_att_holiday_list" model="ir.ui.view">
        <field name="name">st.attendance.holiday.list</field>
        <field name="model">st.attendance.holiday</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="batch_ids" widget="many2many_tags"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>
    <record id="action_att_holiday" model="ir.actions.act_window">
        <field name="name">Holidays</field>
        <field name="res_model">st.attendance.holiday</field>
        <field name="view_mode">list</field>
    </record>
    <menuitem id="menu_att_holiday" name="Holidays" parent="menu_st_attendance"
              action="action_att_holiday" sequence="25"/>

    <record id="ir_cron_attendance_daily_sheets" model="ir.cron">
        <field name="name">Attendance: create today's sheets</field>
        <field name="model_id" ref="model_st_attendance"/>
        <field name="state">code</field>
        <field name="code">model._auto_generate()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 18:35:00')"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
