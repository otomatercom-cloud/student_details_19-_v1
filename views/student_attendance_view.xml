<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- List View -->
    <record id="view_st_attendance_tree" model="ir.ui.view">
        <field name="name">st.attendance.list</field>
        <field name="model">st.attendance</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="batch_id"/>
                <field name="coordinator_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'locked'"
                       decoration-warning="state == 'draft'"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_st_attendance_form" model="ir.ui.view">
        <field name="name">st.attendance.form</field>
        <field name="model">st.attendance</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_print_excel" string="Print Excel"
                            type="object" class="btn-primary"/>
                    <button name="action_unlock" string="Unlock"
                            type="object" class="btn-warning"
                            invisible="state != 'locked'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,locked"/>
                </header>
                <sheet>
                    <group>
                        <field name="date"/>
                        <field name="coordinator_id" readonly="1"/>
                        <field name="batch_id"/>
                    </group>
                    <field name="attendance_line_ids">
                        <list create="0" delete="0" editable="bottom">
                            <field name="student_id" readonly="1" force_save="1"/>
                            <field name="status" readonly="parent.state == 'locked'"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Attendance Summary page inherited into Student form -->
    <record id="view_student_details_form_inherit_attendance" model="ir.ui.view">
        <field name="name">student.details.form.attendance.summary</field>
        <field name="model">student.details</field>
        <field name="inherit_id" ref="student_details_19.view_student_form_v2"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Attendance Summary" name="attendance_summary">
                    <group>
                        <group>
                            <field name="att_start_date"/>
                            <field name="att_end_date"/>
                        </group>
                        <group>
                            <field name="present_days" readonly="1"/>
                            <field name="absent_days" readonly="1"/>
                            <field name="half_days" readonly="1"/>
                            <field name="total_days" readonly="1"/>
                            <field name="attendance_percentage" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Action -->
    <record id="action_st_attendance" model="ir.actions.act_window">
        <field name="name">Attendance</field>
        <field name="res_model">st.attendance</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu: "Attendance" is a folder; records + report are its children -->
    <record id="menu_st_attendance" model="ir.ui.menu">
        <field name="name">Attendance</field>
        <field name="parent_id" ref="menu_student_root"/>
        <field name="sequence">5</field>
        <field name="action" eval="False"/>
    </record>
    <menuitem id="menu_st_attendance_records" name="Attendance Records"
              parent="menu_st_attendance" action="action_st_attendance" sequence="10"/>

</odoo>
