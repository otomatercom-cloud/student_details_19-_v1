<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Root Menu -->
    <menuitem id="menu_student_root" name="Students Details" sequence="10"/>

    <!-- ── List View ──────────────────────────────────────────────────────── -->
    <record id="view_student_tree" model="ir.ui.view">
        <field name="name">student.details.list</field>
        <field name="model">student.details</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="registration_no" string="Register Number" optional="show"/>
                <field name="lead_reference_no" optional="hide"/>
                <field name="joining_status" widget="badge"
                       decoration-info="joining_status == 'new'"
                       decoration-success="joining_status == 'existing'"/>
                <field name="branch"/>
                <field name="phone"/>
                <field name="qualification"/>
                <field name="father_name"/>
                <field name="father_phone"/>
                <field name="mother_name"/>
                <field name="mother_phone"/>
                <field name="guardian_occupation"/>
                <field name="district"/>
                <field name="city"/>
                <field name="school"/>
                <field name="course_ids" widget="many2many_tags"/>
                <field name="portal_sync_state" widget="badge" optional="show"
                       decoration-success="portal_sync_state == 'synced'"
                       decoration-danger="portal_sync_state == 'failed'"/>
                <field name="portal_user_id" string="Portal Login" optional="show"/>
                <field name="moodle_sync_state" widget="badge" optional="show"
                       decoration-success="moodle_sync_state == 'synced'"
                       decoration-danger="moodle_sync_state == 'failed'"/>
                <field name="moodle_username" string="Moodle Username" optional="show"/>
                <field name="moodle_user_id" string="Moodle User ID" optional="show"/>
                <field name="moodle_enrol_state" widget="badge" optional="show"
                       decoration-success="moodle_enrol_state == 'enrolled'"
                       decoration-danger="moodle_enrol_state == 'failed'"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- ── Form View ──────────────────────────────────────────────────────── -->
    <record id="view_student_form_v2" model="ir.ui.view">
        <field name="name">student.details.form</field>
        <field name="model">student.details</field>
        <field name="arch" type="xml">
            <form string="Student">
                <sheet>

                    <!-- oe_button_box: direct child of sheet (Odoo convention) -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_batch_transfer" type="object" class="oe_stat_button" icon="fa-exchange" invisible="not batch_id">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="transfer_count" nolabel="1"/>
                                </span>
                                <span class="o_stat_text">Transfers</span>
                            </div>
                        </button>
                        <button name="action_sync_moodle_and_portal" type="object" class="oe_stat_button" icon="fa-graduation-cap" groups="student_details_19.group_student_manager,student_details_19.group_tl_admission">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="portal_sync_state" widget="badge" decoration-success="portal_sync_state == 'synced'" decoration-danger="portal_sync_state == 'failed'" nolabel="1"/>
                                </span>
                                <span class="o_stat_text">Portal / Moodle</span>
                            </div>
                        </button>
                    </div>

                    <!-- ═══════════════════════════════════════════════════════
                         PROFILE HEADER: Photo LEFT  |  Info RIGHT
                    ════════════════════════════════════════════════════════ -->
                    <div name="profile_card" class="sda-profile-card">

                        <!-- LEFT: Photo panel -->
                        <div name="photo_panel" class="sda-profile-photo-panel">
                            <field name="photo" widget="image" class="sda-profile-photo"/>
                            <div style="margin-top:12px;">
                                <field name="joining_status" widget="badge" decoration-info="joining_status == 'new'" decoration-success="joining_status == 'existing'" style="font-size:11px;"/>
                            </div>
                        </div>

                        <!-- RIGHT: Student identity panel -->
                        <div name="info_panel" class="sda-profile-info-panel">

                            <!-- Name + Register Number -->
                            <div class="oe_title" style="margin-bottom:12px;">
                                <h1 style="margin:0;font-size:22px;font-weight:800;color:#111827;line-height:1.2;">
                                    <field name="name" placeholder="Student Name" nolabel="1"/>
                                </h1>
                                <div class="sda-profile-regno">
                                    <field name="registration_no" readonly="1" nolabel="1" placeholder="Register Number"/>
                                </div>
                            </div>

                            <!-- Quick-info chips -->
                            <div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:14px;">
                                <span class="sda-profile-chip sda-profile-chip-blue">
                                    📧 <field name="email" widget="email" readonly="1" nolabel="1"/>
                                </span>
                                <span class="sda-profile-chip sda-profile-chip-green">
                                    📱 <field name="phone" widget="phone" readonly="1" nolabel="1"/>
                                </span>
                                <span class="sda-profile-chip sda-profile-chip-yellow">
                                    🏢 <field name="branch" readonly="1" nolabel="1"/>
                                </span>
                                <span class="sda-profile-chip sda-profile-chip-brand">
                                    🎓 <field name="batch_id" readonly="1" nolabel="1"/>
                                </span>
                                <button name="action_batch_transfer" type="object" string="🔄 Batch Transfer" invisible="not batch_id" class="sda-profile-transfer-btn"/>
                            </div>

                            <!-- Meta details row -->
                            <div style="display:flex;flex-wrap:wrap;gap:20px;">
                                <div>
                                    <div class="sda-profile-meta-label">Date of Birth</div>
                                    <div class="sda-profile-meta-value">
                                        <field name="date_of_birth" readonly="1" nolabel="1"/>
                                    </div>
                                </div>
                                <div>
                                    <div class="sda-profile-meta-label">Gender</div>
                                    <div class="sda-profile-meta-value">
                                        <field name="gender" readonly="1" nolabel="1"/>
                                    </div>
                                </div>
                                <div>
                                    <div class="sda-profile-meta-label">Courses</div>
                                    <div class="sda-profile-meta-value">
                                        <field name="course_ids" widget="many2many_tags" readonly="1" nolabel="1"/>
                                    </div>
                                </div>
                            </div>

                        </div><!-- /info_panel -->
                    </div><!-- /profile_card -->

                    <div class="sda-card sda-card-portal">
                        <div class="sda-card-header"><i class="fa fa-id-badge"/> Portal &amp; Moodle Identity</div>
                        <group name="portal_moodle_identity">
                            <group>
                                <field name="portal_user_id" string="Portal Login" readonly="1"/>
                            </group>
                            <group>
                                <field name="moodle_username" readonly="1"/>
                                <field name="moodle_user_id" readonly="1"/>
                                <field name="moodle_enrol_state" widget="badge" readonly="1" decoration-success="moodle_enrol_state == 'enrolled'" decoration-danger="moodle_enrol_state == 'failed'"/>
                                <field name="moodle_enrol_message" readonly="1" invisible="not moodle_enrol_message"/>
                            </group>
                        </group>
                    </div>


                    <!-- ═══════════════════════════════════════════════════════
                         EDITABLE FIELDS
                    ════════════════════════════════════════════════════════ -->
                    <group>
                        <group string="Academic &amp; Branch">
                            <field name="email" widget="email"/>
                            <field name="phone" widget="phone"/>
                            <field name="joining_status"/>
                            <field name="admission_officer_text" readonly="1" invisible="joining_status != 'new'"/>
                            <field name="admission_officer_id"/>
                            <field name="branch"/>
                        </group>
                        <group string="Batch &amp; Courses">
                            <field name="date_of_birth"/>
                            <field name="gender"/>
                            <field name="batch_id"/>
                            <field name="registration_no" readonly="1" string="Register Number"/>
                            <field name="lead_reference_no" readonly="1" string="Lead Reference" invisible="not lead_reference_no"/>
                            <field name="roll_no" invisible="1"/>
                            <field name="course_ids" widget="many2many_tags"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Personal Information" name="personal_info">
                            <group>
                                <group string="Address">
                                    <field name="address" placeholder="Street..."/>
                                    <field name="city" placeholder="City"/>
                                    <field name="district"/>
                                </group>
                                <group string="Social">
                                    <field name="insta_id" widget="url" placeholder="Instagram Profile"/>
                                </group>
                            </group>
                        </page>

                        <page string="Education" name="education">
                            <group>
                                <group>
                                    <field name="qualification"/>
                                    <field name="school"/>
                                    <field name="college"/>
                                </group>
                            </group>
                        </page>

                        <page string="Guardian Details" name="guardian">
                            <group>
                                <group string="Father">
                                    <field name="father_name"/>
                                    <field name="father_phone" widget="phone"/>
                                </group>
                                <group string="Mother">
                                    <field name="mother_name"/>
                                    <field name="mother_phone" widget="phone"/>
                                </group>
                                <group string="Other">
                                    <field name="whatsapp_number" widget="phone"/>
                                    <field name="guardian_occupation"/>
                                </group>
                            </group>
                        </page>

                        <!-- ── Batch History Tab ──────────────────────────── -->
                        <page string="Batch History" name="batch_history" invisible="transfer_count == 0">

                            <!-- Current batch summary card -->
                            <div class="sda-batch-history-banner">
                                <div>
                                    <div class="sda-batch-history-kicker">Current Batch</div>
                                    <div class="sda-batch-history-value">
                                        <field name="batch_id" readonly="1" nolabel="1"/>
                                    </div>
                                    <div invisible="not current_batch_join_date" class="sda-batch-history-sub">
                                        📅 Joined:
                                        <field name="current_batch_join_date" readonly="1" nolabel="1"/>
                                    </div>
                                </div>
                                <div class="sda-batch-history-count-box">
                                    <div class="sda-batch-history-count-label">TOTAL TRANSFERS</div>
                                    <div class="sda-batch-history-count-value">
                                        <field name="transfer_count" readonly="1" nolabel="1"/>
                                    </div>
                                </div>
                            </div>

                            <!-- Transfer history timeline list -->
                            <field name="transfer_history_ids" readonly="1">
                                <list create="0" delete="0">
                                    <field name="transfer_date" string="Date"/>
                                    <field name="from_batch_id" string="From Batch"/>
                                    <field name="join_date" string="Joined From-Batch"/>
                                    <field name="to_batch_id" string="To Batch"/>
                                    <field name="transferred_by" string="By"/>
                                    <field name="reason"/>
                                </list>
                            </field>
                        </page>

                    </notebook>

                    <!-- Hidden fields required for invisible conditions -->
                    <field name="transfer_count" invisible="1"/>
                    <field name="current_batch_join_date" invisible="1"/>

                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Actions ────────────────────────────────────────────────────────── -->
    <record id="action_student_details" model="ir.actions.act_window">
        <field name="name">All Students</field>
        <field name="res_model">student.details</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_student_details_new" model="ir.actions.act_window">
        <field name="name">New Students</field>
        <field name="res_model">student.details</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('joining_status','=','new')]</field>
        <field name="context">{'default_joining_status': 'new'}</field>
    </record>
    <record id="action_student_details_existing" model="ir.actions.act_window">
        <field name="name">Existing Students</field>
        <field name="res_model">student.details</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('joining_status','=','existing')]</field>
        <field name="context">{'default_joining_status': 'existing'}</field>
    </record>
    <record id="action_student_details_kochi" model="ir.actions.act_window">
        <field name="name">Kochi Students</field>
        <field name="res_model">student.details</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('branch','=','kochi')]</field>
        <field name="context">{'default_branch': 'kochi'}</field>
    </record>
    <record id="action_student_details_calicut" model="ir.actions.act_window">
        <field name="name">Calicut Students</field>
        <field name="res_model">student.details</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('branch','=','calicut')]</field>
        <field name="context">{'default_branch': 'calicut'}</field>
    </record>
    <record id="action_student_details_kottayam" model="ir.actions.act_window">
        <field name="name">Kottayam Students</field>
        <field name="res_model">student.details</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('branch','=','kottayam')]</field>
        <field name="context">{'default_branch': 'kottayam'}</field>
    </record>
    <record id="action_student_details_trivandrum" model="ir.actions.act_window">
        <field name="name">Trivandrum Students</field>
        <field name="res_model">student.details</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('branch','=','trivandrum')]</field>
        <field name="context">{'default_branch': 'trivandrum'}</field>
    </record>
    <record id="action_student_details_malappuram" model="ir.actions.act_window">
        <field name="name">Malappuram Students</field>
        <field name="res_model">student.details</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('branch','=','malappuram')]</field>
        <field name="context">{'default_branch': 'malappuram'}</field>
    </record>
    <record id="action_student_details_kozhikode" model="ir.actions.act_window">
        <field name="name">Kozhikode Students</field>
        <field name="res_model">student.details</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('branch','=','kozhikode')]</field>
        <field name="context">{'default_branch': 'kozhikode'}</field>
    </record>
    <record id="action_student_details_online" model="ir.actions.act_window">
        <field name="name">Online Students</field>
        <field name="res_model">student.details</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('branch','=','online')]</field>
        <field name="context">{'default_branch': 'online'}</field>
    </record>

    <!-- ── Menus ───────────────────────────────────────────────────────────── -->
    <menuitem id="menu_student_all" name="All Students" parent="menu_student_root"
              action="action_student_details" sequence="1"/>
    <menuitem id="menu_student_new" name="New Students" parent="menu_student_root"
              action="action_student_details_new" sequence="2"/>
    <menuitem id="menu_student_existing" name="Existing Students" parent="menu_student_root"
              action="action_student_details_existing" sequence="3"/>
    <menuitem id="menu_student_branches_root" name="Branches" parent="menu_student_root" sequence="4"/>
    <menuitem id="menu_student_kochi" name="Kochi" parent="menu_student_branches_root"
              action="action_student_details_kochi" sequence="10"/>
    <menuitem id="menu_student_calicut" name="Calicut" parent="menu_student_branches_root"
              action="action_student_details_calicut" sequence="20"/>
    <menuitem id="menu_student_kottayam" name="Kottayam" parent="menu_student_branches_root"
              action="action_student_details_kottayam" sequence="30"/>
    <menuitem id="menu_student_trivandrum" name="Trivandrum" parent="menu_student_branches_root"
              action="action_student_details_trivandrum" sequence="40"/>
    <menuitem id="menu_student_malappuram" name="Malappuram" parent="menu_student_branches_root"
              action="action_student_details_malappuram" sequence="50"/>
    <menuitem id="menu_student_kozhikode" name="Kozhikode" parent="menu_student_branches_root"
              action="action_student_details_kozhikode" sequence="60"/>
    <menuitem id="menu_student_online" name="Online" parent="menu_student_branches_root"
              action="action_student_details_online" sequence="70"/>

    <!-- ── Bulk Action: Sync to Moodle + Create Portal Users ─────────────── -->
    <record id="action_server_sync_moodle_portal" model="ir.actions.server">
        <field name="name">Create Portal Users / Sync to Moodle</field>
        <field name="model_id" ref="model_student_details"/>
        <field name="binding_model_id" ref="model_student_details"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = records.action_sync_moodle_and_portal()</field>
        <field name="group_ids" eval="[(4, ref('student_details_19.group_student_manager')),
                                        (4, ref('student_details_19.group_tl_admission'))]"/>
    </record>

</odoo>
