<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_course_master_tree" model="ir.ui.view">
        <field name="name">course.master.list</field>
        <field name="model">course.master</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_course_master_form" model="ir.ui.view">
        <field name="name">course.master.form</field>
        <field name="model">course.master</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="active"/>
                        <field name="coordinator_ids" widget="many2many_tags"/>
                    </group>
                    <notebook>
                        <page string="Batches">
                            <field name="batch_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_course_master" model="ir.actions.act_window">
        <field name="name">Courses</field>
        <field name="res_model">course.master</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_course_master" name="Courses" action="action_course_master"
              parent="menu_student_root" sequence="9"/>

</odoo>
