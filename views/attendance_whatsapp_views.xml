<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_att_wa_log_search" model="ir.ui.view">
        <field name="name">otm.attendance.whatsapp.log.search</field>
        <field name="model">otm.attendance.whatsapp.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="student_id"/>
                <field name="number"/>
                <field name="batch_id"/>
                <filter name="queued" string="Queued" domain="[('state', '=', 'queued')]"/>
                <filter name="sent" string="Sent" domain="[('state', '=', 'sent')]"/>
                <filter name="failed" string="Failed" domain="[('state', 'in', ('failed', 'skipped'))]"/>
                <separator/>
                <filter name="absent" string="Absent Alerts" domain="[('message_type', '=', 'absent')]"/>
                <filter name="low" string="Low Attendance" domain="[('message_type', '=', 'low_attendance')]"/>
                <separator/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_type" string="Type" context="{'group_by': 'message_type'}"/>
                    <filter name="group_batch" string="Batch" context="{'group_by': 'batch_id'}"/>
                    <filter name="group_day" string="Day" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_att_wa_log_tree" model="ir.ui.view">
        <field name="name">otm.attendance.whatsapp.log.list</field>
        <field name="model">otm.attendance.whatsapp.log</field>
        <field name="arch" type="xml">
            <list create="0" decoration-danger="state == 'failed'" decoration-muted="state == 'skipped'">
                <header>
                    <button name="action_retry" type="object" string="Retry"/>
                    <button name="action_send_now" type="object" string="Send Now"/>
                </header>
                <field name="create_date" string="Created"/>
                <field name="student_id"/>
                <field name="batch_id" optional="show"/>
                <field name="message_type"/>
                <field name="number"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'sent'"
                       decoration-warning="state == 'queued'"
                       decoration-danger="state == 'failed'"/>
                <field name="retries" optional="hide"/>
                <field name="sent_on" optional="show"/>
                <field name="error" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_att_wa_log_form" model="ir.ui.view">
        <field name="name">otm.attendance.whatsapp.log.form</field>
        <field name="model">otm.attendance.whatsapp.log</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_send_now" type="object" string="Send Now" class="btn-primary"
                            invisible="state != 'queued'"/>
                    <button name="action_retry" type="object" string="Retry"
                            invisible="state not in ('failed', 'skipped')"/>
                    <field name="state" widget="statusbar" statusbar_visible="queued,sent"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="student_id"/>
                            <field name="batch_id"/>
                            <field name="attendance_id"/>
                            <field name="message_type"/>
                        </group>
                        <group>
                            <field name="number"/>
                            <field name="template_name"/>
                            <field name="retries"/>
                            <field name="sent_on"/>
                        </group>
                    </group>
                    <group string="Message">
                        <field name="message" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Provider Response / Error">
                        <field name="error" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_att_wa_log" model="ir.actions.act_window">
        <field name="name">Attendance WhatsApp Log</field>
        <field name="res_model">otm.attendance.whatsapp.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_att_wa_log_search"/>
    </record>

    <menuitem id="menu_att_wa_log" name="WhatsApp Log" parent="menu_st_attendance"
              action="action_att_wa_log" sequence="30"/>

    <!-- Sends queued messages every 5 minutes (also triggered right after a sheet is locked) -->
    <record id="ir_cron_attendance_whatsapp_queue" model="ir.cron">
        <field name="name">Attendance WhatsApp: send queued messages</field>
        <field name="model_id" ref="model_otm_attendance_whatsapp_log"/>
        <field name="state">code</field>
        <field name="code">model._cron_process_queue()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

</odoo>
